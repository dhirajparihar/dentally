# MongoDB Connection (Optional for demo, required for persistent cloud database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dentally?retryWrites=true&w=majority

# App Base URL (Used for remote MCP URL generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Credentials (for ChatGPT OAuth 2.0 connection)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=your-random-32-character-secret
